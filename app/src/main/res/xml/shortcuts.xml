<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: straight to a brain dump, the Inbox, or a plan for the day. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="brain_dump"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_dump_short"
        android:shortcutLongLabel="@string/shortcut_dump_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.taskmind"
            android:targetClass="com.taskmind.MainActivity">
            <extra android:name="com.taskmind.extra.ROUTE" android:value="dump" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="inbox"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_inbox_short"
        android:shortcutLongLabel="@string/shortcut_inbox_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.taskmind"
            android:targetClass="com.taskmind.MainActivity">
            <extra android:name="com.taskmind.extra.ROUTE" android:value="review" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="plan_day"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_plan_short"
        android:shortcutLongLabel="@string/shortcut_plan_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.taskmind"
            android:targetClass="com.taskmind.MainActivity">
            <extra android:name="com.taskmind.extra.ROUTE" android:value="twin|plan" />
        </intent>
    </shortcut>
</shortcuts>
