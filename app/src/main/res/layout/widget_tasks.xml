    <!--
      Paging, not scrolling. A scrolling widget needs a ListView fed by a
      RemoteViewsService, which is the mechanism that failed twice on this
      device. Two buttons and an offset reach every task using nothing but the
      static views that are known to work.
    -->
    <LinearLayout
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_prev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingEnd="10dp"
            android:paddingTop="2dp"
