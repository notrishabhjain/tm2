<?xml version="1.0" encoding="utf-8"?>
<!--
  One row of the scrolling list.

  THE BAR IS A TextView, NOT A View, AND THAT IS THE WHOLE STORY.

  The first version of this file used a bare <View> for the accent bar, and
  the launcher drew "Couldn't add widget." in every row. `View` is not on the
  documented list of classes RemoteViews supports - TextView, ImageView,
  Button, the layouts and the collection views are, and `View` is conspicuously
  absent. It survives being applied in-process, which is why a static layout
  using one looked fine, but a collection item is serialised across a binder
  into the launcher and validated strictly. That is where it failed, twice,
  and it took removing it for an unrelated reason to notice.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <TextView
        android:id="@+id/item_accent"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="10dp"
        android:text=""
        android:background="@color/widget_accent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/widget_on_surface" />

        <TextView
            android:id="@+id/item_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone"
            android:textColor="@color/widget_on_surface_variant" />
    </LinearLayout>

    <TextView
        android:id="@+id/item_done"
        android:layout_width="40dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/widget_tick"
        android:textSize="17sp"
        android:textColor="@color/widget_accent" />
</LinearLayout>
