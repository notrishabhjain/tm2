# Copy these from your Supabase project: Settings -> API.
# Both are safe in a browser bundle - the anon key is designed to be public,
# and row-level security is what actually protects the data. Never put the
# service_role key here; it bypasses RLS entirely.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
